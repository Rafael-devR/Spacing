<?xml version="1.0" encoding="utf-8"?>
<!-- App sem Java: a NativeActivity do Android carrega libspacing_bench.so e chama android_main (src/lib.rs). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:hasCode="false"
        android:label="Spacing teste nativo"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="spacing_bench" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
